# Copy to .env (never committed). On the Raspberry Pi the keys live in
# /etc/kore/kore.env instead (see deploy/pi/install.sh).

# Required for the live voice
ANTHROPIC_API_KEY=          # Claude: the conversation brain
ELEVENLABS_API_KEY=         # speech-to-text and Pepe's voice
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_TTS_MODEL=

# Optional: how messages reach the family (all off until set)
# TELEGRAM_BOT_TOKEN=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# TWILIO_WHATSAPP_FROM=
# TWILIO_WHATSAPP_TEMPLATE=

# Optional: device health and backups
# KORE_HEARTBEAT_URL=       # pinged every few minutes; alerts if it goes quiet
# KORE_BACKUP_CERT=         # public certificate the nightly backup is encrypted to

# Optional: Raspberry Pi hardware (defaults suit the reference box)
# KORE_PIN_BUTTON=  KORE_PIN_PRESENCE=  KORE_LONG_PRESS_S=
# KORE_LED_COUNT=  KORE_LED_BRIGHTNESS=  KORE_LED_SPI_BUS=  KORE_LED_SPI_DEVICE=
